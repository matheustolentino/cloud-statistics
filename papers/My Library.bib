@article{tatiananomokonovaStatisticsCloudsTheir2019,
  title = {Statistics on Clouds and Their Relation to Thermodynamic Conditions at {{Ny-{\AA}lesund}} Using Ground-Based Sensor Synergy},
  author = {{Tatiana Nomokonova} and Nomokonova, Tatiana and {Kerstin Ebell} and Ebell, Kerstin and {Ulrich L{\"o}hnert} and L{\"o}hnert, Ulrich and {Marion Maturilli} and Maturilli, Marion and {Christoph Ritter} and Ritter, Christoph and {Ewan O'Connor} and O'Connor, Ewan},
  year = {2019},
  month = apr,
  journal = {Atmospheric Chemistry and Physics},
  volume = {19},
  number = {6},
  pages = {4105--4126},
  doi = {10.5194/acp-19-4105-2019},
  abstract = {Abstract. The French--German Arctic research base AWIPEV (the Alfred Wegener Institute Helmholtz Centre for Polar and Marine Research -- AWI -- and the French Polar Institute Paul Emile Victor -- PEV) at Ny-Alesund, Svalbard, is a unique station for monitoring cloud-related processes in the Arctic. For the first time, data from a set of ground-based instruments at the AWIPEV observatory are analyzed to characterize the vertical structure of clouds. For this study, a 14-month dataset from Cloudnet combining observations from a ceilometer, a 94GHz cloud radar, and a microwave radiometer is used. A total cloud occurrence of  {$\sim$}81 \%, with 44.8\% multilayer and 36\% single-layer clouds, was found. Among single-layer clouds the occurrence of liquid, ice, and mixed-phase clouds was 6.4\%, 9\%, and 20.6\%, respectively. It was found that more than 90\% of single-layer liquid and mixed-phase clouds have liquid water path(LWP) values lower than 100and 200gm -2 , respectively. Mean values of ice water path(IWP) for ice and mixed-phase clouds were found to be 273and 164gm -2 , respectively. The different types of single-layer clouds are also related to in-cloud temperature and the relative humidity under which they occur. Statistics based on observations are compared to ICOsahedral Non-hydrostatic(ICON) model output. Distinct differences in liquid-phase occurrence in observations and the model at different environmental temperatures lead to higher occurrence of pure ice clouds. A lower occurrence of mixed-phase clouds in the model at temperatures between  -20 and  -5  {$\circ$} C becomes evident. The analyzed dataset is useful for satellite validation and model evaluation.},
  annotation = {MAG ID: 2899361914\\
S2ID: ebc0a8f916f7245b96910f2f1e4772480888b7a8},
  file = {/home/matheustolen/snap/zotero-snap/common/Zotero/storage/99CW4YBB/Tatiana Nomokonova et al. - 2019 - Statistics on clouds and their relation to thermod.pdf}
}

