@article{yoshidaEffectsVerticalProfiles2005,
  title = {Effects of the {{Vertical Profiles}} of {{Cloud Droplets}} and {{Ice Particles}} on the {{Visible}} and {{Near-Infrared Radiative Properties}} of {{Mixed-Phase Stratocumulus Clouds}}},
  author = {Yoshida, Yukio and Asano, Shoji},
  year = {2005},
  journal = {Journal of the Meteorological Society of Japan. Ser. II},
  volume = {83},
  number = {4},
  pages = {471--480},
  doi = {10.2151/jmsj.83.471},
  abstract = {Such cloud radiative propenies as reflectance, transmittance, and absorptance of mixed-phase clouds have been simulated for the stratocumulus cloud observed on 30 January 1999 within the Japanese Cloud and Climate Study (JACCS) program, in which simultaneous observations of the cloud microphysical and radiative properties were conducted. The stratocumulus cloud was in mixed-phased condition, and highly heterogeneous vertically and horizontally with different mixing ratios of liquid water droplets and ice particles. A vertically-homogeneous, plane-parallel mixed-phase cloud model could reproduce the observed visible (VIS; wavelength {$<$} 0.7 {$\mu$}m) band radiative properties, but it could not reproduce the near-infrared (NIR; {$>$} 0.7 {$\mu$}m) band radiative properties. A multi-layered, plane-parallel mixed-phase cloud model could consistently reproduce the observed VIS-band and NIR-band radiative properties within the measurement accuracy. It is found that the venical profiles of water droplets and ice particles are an important factor to determine the radiative properties of mixed-phase clouds. The simulated results suggested that the NIR-band reflectance and absorptance could vary by more than 0.1 due to different vertical distributions of the cloud microphysical properties even the model clouds had constant liquid-water-path and ice-water-path. The visible and near-infrared solar reflection can be also affected by the vertical profiles of cloud microphysical properties; it is suggested that the conventional passive remote sensing under the assumption of vertical-homogeneity, may bring large errors in estimation of the microphysical propenies of mixed-phase clouds.},
  file = {/home/matheustolen/snap/zotero-snap/common/Zotero/storage/KWN6KDVH/Yoshida and Asano - 2005 - Effects of the Vertical Profiles of Cloud Droplets.pdf;/home/matheustolen/snap/zotero-snap/common/Zotero/storage/UFXDML2P/_article.html}
}

@article{zhaoUnderstandingDifferencesCurrent2012,
  title = {Toward Understanding of Differences in Current Cloud Retrievals of {{ARM}} Ground-Based Measurements},
  author = {Zhao, Chun and {Chuanfeng Zhao} and Zhao, Chuanfeng and {Chuanfeng Zhao} and {Shaocheng Xie} and Xie, Shaocheng and {Stephen A. Klein} and Klein, Stephen A. and {Alain Protat} and Protat, Alain and {Alain Protat} and {Matthew D. Shupe} and Shupe, Matthew D. and {Sally A. McFarlane} and McFarlane, Sally A. and {J. M. Comstock} and Comstock, Jennifer M. and {Julien Delano{\"e}} and Delano{\"e}, Julien and {Min Deng} and Deng, Min and {M. Dunn} and Dunn, M. and {Robin J. Hogan} and Hogan, Robin J. and {Dong Huang} and Huang, Dong and {Michael P. Jensen} and Jensen, Michael and {Gerald G. Mace} and Mace, Gerald G. and {Renata McCoy} and McCoy, Renata B. and {Ewan O'Connor} and O'Connor, Ewan and {David D. Turner} and Turner, David D. and {Zhien Wang} and Wang, Zhien},
